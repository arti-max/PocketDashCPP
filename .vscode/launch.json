{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PocketDash (Debug with GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/PocketDash/PocketDash",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/bin/PocketDash",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build PocketDash"
    }
  ]
}
